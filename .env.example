# ============================================================
# insightWOS v3.0 — Environment Variables (Template)
# Copy ke .env.local lalu isi values
# ============================================================

# ── Supabase (Frontend + API Routes) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXX

# ── Supabase (Server-side only) ───────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_XXXXX

# ── PostgreSQL (PgBouncer Transaction Mode, port 6543) ────
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Upstash Redis (Cache untuk Level 3-5 saja) ────────────
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=XXXXX
