# INSIGHTWOS V6 — Environment Variables
# Copy this to .env.local and fill in values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase DB (for backups — DIRECT connection)
SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Neon Cold Standby (for backup restore)
NEON_DB_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb

# PostHog Analytics
VITE_POSTHOG_KEY=your-posthog-key

# Upstash Redis (optional — for server-side caching)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Gemini AI (optional — for AI copilot)
VITE_GEMINI_API_KEY=your-gemini-key
