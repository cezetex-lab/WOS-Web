# ============================================================
# insightWOS v3.0 — Environment Variables (Template)
# Copy ke .env lalu isi values. JANGAN commit file .env!
# ============================================================

# ── Supabase (Frontend — diekspos ke browser) ─────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# ── Supabase (Server-side only — JANGAN dipakai di frontend)
# SUPABASE_SERVICE_KEY=eyJ...your_service_role_key_here

# ── Upstash Redis (Hanya untuk Edge Functions / Server)
# UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=XXXXX

# ── Security Notes ────────────────────────────────────────
# - Anon key AMAN untuk frontend (RLS melindungi data)
# - Service role key HANYA untuk server/Edge Functions
# - Redis credentials HANYA untuk server/Edge Functions
# - Semua env vars dengan prefix VITE_ diekspos ke browser
# - Env vars tanpa prefix VITE_ TIDAK diekspos ke browser
