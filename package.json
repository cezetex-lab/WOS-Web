{
  "name": "wos-web",
  "type": "module",
  "version": "1.0.0",
  "description": "insightWOS — Workforce Intelligence Platform",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:a11y": "npx playwright test tests/a11y/ --config=playwright.a11y.config.ts --project=chromium",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "start": "vite preview --port 3000",
    "deploy": "vercel --prod",
    "build:analyze": "vite build --mode analysis",
    "check:types": "tsc --noEmit",
    "db:migrate": "node supabase/scripts/apply-migration.mjs",
    "db:replay": "node supabase/scripts/replay-fresh-install.mjs",
    "db:baseline": "node supabase/scripts/generate-baseline.mjs && node supabase/scripts/generate-baseline-data.mjs",
    "install:baseline": "node supabase/scripts/install-baseline.mjs",
    "db:verify-install": "node supabase/scripts/verify-install-e2e.mjs",
    "db:rehearse-newco": "node supabase/scripts/rehearse-new-company.mjs",
    "db:refresh-checksums": "node supabase/scripts/refresh-migration-checksums.mjs",
    "db:seed-test": "node supabase/scripts/seed-test-workers.mjs --apply && npm run smoke:ops01 -- --headless",
    "smoke:ops01": "node scripts/run-ops01-smoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/redis": "^1.28.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.39.0",
    "pg": "^8.23.0",
    "posthog-js": "^1.422.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.5",
    "@babel/eslint-parser": "^8.0.5",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "dotenv": "^16.3.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^14.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
